<Project Sdk="Microsoft.NET.Sdk">

  <!-- MAUI app with no XAML at all. Host approach from spikes/windows-no-appxaml.
       Android is opt-in like the library's mobile TFMs (-p:PureMarkupMobile=true, docs/android.md). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(PureMarkupMobile)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>ScreenshotPage</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsPackable>false</IsPackable>

    <ApplicationTitle>PureMarkup ScreenshotPage</ApplicationTitle>
    <ApplicationId>com.yourappnerds.puremarkup.screenshotpage</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <!-- No App.xaml means no XAML Page/ApplicationDefinition items, so the Windows App SDK skips
         resources.pri; WinUI then cannot find its theme resources. Force it on. -->
    <AppxGeneratePriEnabled>true</AppxGeneratePriEnabled>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Trim/AOT check (docs/trimming-aot.md): -p:PureMarkupTrimCheck=true turns on trimmed publish
       and the AOT analyzers here only; passing PublishTrimmed globally would reach the
       netstandard2.0 generator project and fail with NETSDK1124. -->
  <PropertyGroup Condition="'$(PureMarkupTrimCheck)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <PublishAot Condition="'$(PureMarkupAotCheck)' == 'true'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- MAUI otherwise hides trim warnings unless TrimMode=full (see the library csproj). -->
    <_MauiDoNotConfigureTrimAnalyzer>true</_MauiDoNotConfigureTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PureMarkup.Maui\PureMarkup.Maui.csproj" />
  </ItemGroup>

</Project>
