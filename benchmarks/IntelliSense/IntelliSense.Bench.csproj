<Project Sdk="Microsoft.NET.Sdk">

  <!-- Measures what PureMarkup costs the editor: completion latency and item count, and the
       generator's per-keystroke work. Not shipped; see docs/intellisense-speed.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PureMarkup.Maui.Generators\PureMarkup.Maui.Generators.csproj" />
    <!-- Brings PureMarkup.Maui.dll (net10.0) and Microsoft.Maui.Controls into the output, used as the
         consumer project's metadata references. -->
    <ProjectReference Include="..\..\src\PureMarkup.Maui\PureMarkup.Maui.csproj" />
  </ItemGroup>

</Project>
