<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 lets the test project reference the library without a platform TFM.
         Mobile TFMs are opt-in (-p:PureMarkupMobile=true): on this machine their restore fails with
         NETSDK1147 (wasm-tools workload missing). -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(PureMarkupMobile)' == 'true'">$(TargetFrameworks);net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>PureMarkup.Maui</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>PureMarkup.Maui</PackageId>
    <Version>0.1.0-dev</Version>
    <Description>C# markup for .NET MAUI without XAML: fluent, trimmable extension methods for every Microsoft.Maui.Controls type, plus a source generator for your own controls.</Description>
    <PackageTags>maui;markup;csharp-markup;source-generator;no-xaml</PackageTags>
    <PackageProjectUrl>https://github.com/YourAppNerds/pure-markup-maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/YourAppNerds/pure-markup-maui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <!-- Ship the generator so consumers can run [assembly: GenerateMarkup(typeof(MyControl))].
         The WholeAssembly attribute in GenerateMarkup.cs is [Conditional] and never reaches this
         assembly's metadata, and the generator reads only the consuming compilation's own
         attributes, so consumers do not re-generate the MAUI methods. -->
    <None Include="..\PureMarkup.Maui.Generators\bin\$(Configuration)\netstandard2.0\PureMarkup.Maui.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PureMarkup.Maui.Generators\PureMarkup.Maui.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
