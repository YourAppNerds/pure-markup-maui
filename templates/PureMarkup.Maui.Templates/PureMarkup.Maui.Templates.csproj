<Project Sdk="Microsoft.NET.Sdk">

  <!-- dotnet new templates: puremarkup-app (project) and puremarkup-page (item).
       Template sources live under content/<template>/ and are packed as-is; nothing here compiles.
       Microsoft.TemplateEngine.Authoring.Tasks validates the templates on pack. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>PureMarkup.Maui.Templates</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Title>PureMarkup.Maui templates</Title>
    <Description>dotnet new templates for .NET MAUI apps written in C# markup with PureMarkup.Maui, with no XAML files on any platform: puremarkup-app and puremarkup-page.</Description>
    <PackageTags>dotnet-new;templates;maui;markup;csharp;xaml-free;source-generator</PackageTags>

    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Keep .template.config (a dot folder) in the package. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <LocalizeTemplates>false</LocalizeTemplates>
    <IncludeSymbols>false</IncludeSymbols>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**" Exclude="content\**\bin\**;content\**\obj\**" PackagePath="content" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Authoring.Tasks" PrivateAssets="all" />
  </ItemGroup>

</Project>
