{
  "$schema": "http://json.schemastore.org/template",
  "author": "YourAppNerds",
  "classifications": [ "MAUI", "Android", "iOS", "Mac Catalyst", "WinUI", "Code", "C# Markup" ],
  "identity": "PureMarkup.Maui.Page.CSharp",
  "groupIdentity": "PureMarkup.Maui.Page",
  "name": ".NET MAUI ContentPage (PureMarkup)",
  "description": "A ContentPage written in C# markup with PureMarkup.Maui.",
  "shortName": "puremarkup-page",
  "precedence": "100",
  "generatorVersions": "[1.0.0.0-*)",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "sourceName": "NewPage1",
  "defaultName": "NewPage1",
  "primaryOutputs": [
    {
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "path": "NewPage1.cs"
    }
  ],
  "postActions": [
    {
      "id": "openInEditor",
      "condition": "(HostIdentifier != \"dotnetcli\" && HostIdentifier != \"dotnetcli-preview\")",
      "description": "Opens NewPage1.cs in the editor.",
      "manualInstructions": [ { "text": "Open NewPage1.cs in the editor" } ],
      "actionId": "84C0DA21-51C8-4541-9940-6CA19AF04EE6",
      "args": {
        "files": "0"
      },
      "continueOnError": true
    }
  ],
  "symbols": {
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "description": "Namespace for the generated code (default: the project's RootNamespace)."
    },
    "projectNamespace": {
      "type": "bind",
      "binding": "msbuild:RootNamespace",
      "defaultValue": "MyApp"
    },
    "finalNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "namespace",
        "fallbackVariableName": "projectNamespace"
      },
      "replaces": "PureMarkupApp1"
    },
    "HostIdentifier": {
      "type": "bind",
      "binding": "HostIdentifier"
    }
  }
}
